# ─── API (Backend) ────────────────────────────────────────────────────────────
# URL de la base de datos PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/mototaxi_db"

# Secret para firmar los tokens JWT (mínimo 32 caracteres aleatorios)
JWT_SECRET="CAMBIA_ESTO_POR_UN_SECRET_ALEATORIO_LARGO"
JWT_EXPIRES_IN="7d"

# Origenes permitidos en CORS (separados por coma, sin espacios)
# Ejemplo: https://tu-dashboard.vercel.app,https://mi-dominio.com
CORS_ORIGINS="http://localhost:5173"

# Puerto del servidor (Railway lo asigna automáticamente)
PORT=3001

# Entorno de ejecución
NODE_ENV="development"

# ─── Dashboard (Frontend) ─────────────────────────────────────────────────────
# URL del API backend (para producción, usa la URL de Railway)
VITE_API_URL="http://localhost:3001"
VITE_SOCKET_URL="http://localhost:3001"

# ─── App Móvil (Expo) ─────────────────────────────────────────────────────────
# URL del API visible desde el dispositivo móvil
# DESARROLLO: usa la IP de tu PC en la red WiFi local (ej: http://192.168.0.X:3001)
# PRODUCCIÓN: usa la URL de Railway
EXPO_PUBLIC_API_URL="http://192.168.0.104:3001"

# Deshabilitar verificación de paquetes en Expo CLI (evita error undici en Node.js)
EXPO_NO_DOCTOR=1
EXPO_OFFLINE=1
