{
  "expo": {
    "name": "Mototaxis Municipales",
    "slug": "mototaxi-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE"
      ],
      "package": "com.municipio.mototaxi"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Se requiere ubicación GPS constante para rastrear tu posición durante el viaje."
        }
      ]
    ],
    "scheme": "mototaxi",
    "experiments": {
      "typedRoutes": true
    }
  }
}
