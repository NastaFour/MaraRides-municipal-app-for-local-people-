{
  "version": 2,
  "builds": [
    {
      "src": "packages/dashboard/dist/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/packages/dashboard/dist/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/packages/dashboard/dist/index.html"
    }
  ]
}
